# Environment Configuration for VOXGUARD

# Application
APP_NAME=VOXGUARD
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=voxguard-insecure-dev-secret-key-change-in-production-2026-xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database (PostgreSQL 17)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=voxguard
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voxguard
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/voxguard

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_DIR=storage
RECORDINGS_DIR=storage/recordings
REPORTS_DIR=storage/reports

# AI & Voice Engine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
DEVICE=cuda

# Safety & Compliance
MAX_COLLECTOR_TALK_RATIO=0.75
AROUSAL_DISTRESS_THRESHOLD=0.75
VALENCE_DISTRESS_THRESHOLD=-0.60
DISTRESS_PERSISTENCE_WINDOWS=3
